# Copia este archivo como .env y completa los valores.
# En Docker, docker-compose sobreescribe DB_HOST y DB_PASSWORD.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=datacl
DB_USER=root
DB_PASSWORD=

# Genera una clave nueva para produccion.
SECRET_KEY=datacl_secret_key_2026

# Origenes permitidos por CORS, separados por coma.
# Si el frontend llama al API por el mismo dominio, puedes limitarlo a tu dominio publico.
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173,http://127.0.0.1

# Clave de la API de Groq (necesaria para clasificacion automatica de campos)
GROQ_API_KEY=

# Solo si vas a crear el usuario admin inicial con app.utils.crear_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
