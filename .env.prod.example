# Archivo de produccion para Docker Compose.
# Copialo como .env.prod y completa los valores antes de desplegar.

# MySQL interno del stack
MYSQL_ROOT_PASSWORD=pon_aqui_una_clave_larga_y_unica
MYSQL_DATABASE=datacl
MYSQL_USER=datacl_app
MYSQL_PASSWORD=pon_aqui_otra_clave_larga_y_unica

# Credenciales que usa el backend para conectarse a MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=datacl
DB_USER=datacl_app
DB_PASSWORD=pon_aqui_otra_clave_larga_y_unica

# JWT del backend. Debe ser nueva y distinta a cualquier otra clave.
SECRET_KEY=pon_aqui_una_secret_key_nueva

# Origen(es) web permitidos por CORS.
# Si frontend y backend van bajo el mismo dominio con proxy, usa el dominio publico.
CORS_ORIGINS=https://tudominio.cl,https://www.tudominio.cl

# API key para los analisis con Groq.
GROQ_API_KEY=pon_aqui_tu_groq_api_key

# Solo si vas a crear el usuario administrador inicial.
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=pon_aqui_una_password_fuerte
